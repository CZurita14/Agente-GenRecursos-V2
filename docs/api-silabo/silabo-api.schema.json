{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uti.edu.ec/generador-recursos/silabo-api.v1.schema.json",
  "title": "Sílabo UTI para el Generador de Recursos · contrato v1.0",
  "description": "Apartados académicos del sílabo que consume el sistema. No incluye la sección I (perfil y contacto del docente) ni la VII (firmas): la API no debe enviarlas. El SGA envía lo que guarda; el sistema deriva el id de sesión, la semana del periodo y los entregables cuando no vienen. Validado con 51 sílabos reales del periodo B26.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facultad",
    "carrera",
    "periodo",
    "proyecto_formativo",
    "competencia_perfil",
    "resultados_aprendizaje",
    "problema",
    "momentos"
  ],
  "properties": {
    "facultad": {
      "type": "string",
      "minLength": 1,
      "description": "Nombre oficial de la facultad. Elige el agente y el estilo de la facultad."
    },
    "carrera": {
      "type": "string",
      "minLength": 1,
      "description": "Nombre oficial de la carrera o del programa de posgrado."
    },
    "periodo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codigo",
        "inicio",
        "fin"
      ],
      "properties": {
        "codigo": {
          "type": "string",
          "description": "Código del periodo académico, p. ej. B26."
        },
        "inicio": {
          "type": "string",
          "format": "date"
        },
        "fin": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "proyecto_formativo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codigo",
        "nombre",
        "version",
        "aprobado",
        "nivel"
      ],
      "properties": {
        "codigo": {
          "type": "string",
          "minLength": 1,
          "description": "Código del proyecto formativo, p. ej. B26-SOFT-3-56157-1727. Identifica el sílabo y debe ser igual al codigo_pf de la materia. La sigla de la carrera tiene de 1 a 5 letras y puede llevar un prefijo."
        },
        "nombre": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Versión del sílabo, p. ej. 1.0. Debe cambiar cada vez que cambia el sílabo."
        },
        "aprobado": {
          "type": "string",
          "format": "date",
          "description": "Fecha de aprobación; elige la versión vigente."
        },
        "nivel": {
          "type": "integer",
          "minimum": 1,
          "description": "Nivel o semestre de la malla (1 a 10)."
        },
        "uoc": {
          "type": "string",
          "description": "Opcional. Unidad de organización curricular."
        },
        "modalidad": {
          "type": "string",
          "description": "Opcional. PRESENCIAL, EN LINEA o HIBRIDA."
        },
        "creditos": {
          "type": "number",
          "description": "Opcional. Créditos de la asignatura."
        },
        "horas": {
          "type": "object",
          "description": "Opcional. Si viene, trae las cuatro horas.",
          "additionalProperties": false,
          "properties": {
            "total": {
              "type": "number"
            },
            "contacto": {
              "type": "number"
            },
            "autonomo": {
              "type": "number"
            },
            "practico": {
              "type": "number"
            }
          },
          "required": [
            "total",
            "contacto",
            "autonomo",
            "practico"
          ]
        },
        "horario": {
          "type": "array",
          "description": "Opcional. Franjas de clase; las horas en formato HH:MM.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dia",
              "inicio",
              "fin"
            ],
            "properties": {
              "dia": {
                "type": "string"
              },
              "inicio": {
                "type": "string"
              },
              "fin": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "competencia_perfil": {
      "type": "string",
      "minLength": 1,
      "description": "Competencia del perfil de egreso a la que aporta la asignatura."
    },
    "competencia_pf": {
      "type": "string",
      "description": "Opcional. Competencia del proyecto formativo."
    },
    "metacompetencia": {
      "type": "string",
      "description": "Opcional."
    },
    "resultados_aprendizaje": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "texto",
          "evidencia"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "RA1, RA2, ...; se referencia desde momentos[].ra."
          },
          "texto": {
            "type": "string",
            "minLength": 1
          },
          "evidencia": {
            "type": "string",
            "description": "Evidencia del resultado; puede ir vacía."
          }
        }
      }
    },
    "problema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descripcion",
        "reto",
        "producto_final"
      ],
      "properties": {
        "descripcion": {
          "type": "string"
        },
        "reto": {
          "type": "string"
        },
        "producto_final": {
          "type": "string"
        }
      },
      "description": "Problema del contexto. Las tres claves son obligatorias; el texto puede ir vacío si el sílabo no lo tiene."
    },
    "momentos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "numero",
          "titulo",
          "fecha_inicio",
          "fecha_fin",
          "ra",
          "evidencia",
          "politica_ia",
          "rubrica",
          "sesiones"
        ],
        "properties": {
          "numero": {
            "type": "integer",
            "minimum": 1
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "fecha_inicio": {
            "type": "string",
            "format": "date"
          },
          "fecha_fin": {
            "type": "string",
            "format": "date"
          },
          "ra": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids de resultados_aprendizaje que trabaja el momento."
          },
          "evidencia": {
            "type": "string",
            "description": "Evidencia de desempeño del momento. Es un entregable: el sistema no la resuelve."
          },
          "politica_ia": {
            "type": "string",
            "description": "Política de gobernanza de IA del momento."
          },
          "recursos": {
            "type": "string",
            "description": "Opcional. Recursos para el aprendizaje."
          },
          "rubrica": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/fila_rubrica"
            },
            "description": "Rúbrica del momento; puede ir vacía."
          },
          "sesiones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "numero",
                "fecha",
                "contenidos",
                "docente",
                "practico",
                "autonomo"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Opcional. Si no viene, el sistema lo arma como M<momento>-S<numero>, p. ej. M2-S1."
                },
                "numero": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Número de la sesión como aparece en el sílabo; no se repite dentro del sílabo."
                },
                "fecha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date",
                  "description": "Fecha de la sesión (AAAA-MM-DD), dentro del periodo. null si el SGA no tiene fecha programada: esa sesión no se importa y el docente recibe un aviso."
                },
                "semana_periodo": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Opcional. Si no viene, el sistema la calcula: semana 1 es la del lunes de periodo.inicio."
                },
                "contenidos": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Un elemento por contenido de la sesión. Puede ir vacío si la sesión no tiene contenidos."
                },
                "docente": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "texto"
                  ],
                  "properties": {
                    "texto": {
                      "type": "string"
                    },
                    "horas": {
                      "type": "number"
                    },
                    "asincronica": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": false,
                      "required": [
                        "texto"
                      ],
                      "properties": {
                        "texto": {
                          "type": "string"
                        },
                        "horas": {
                          "type": "number"
                        }
                      },
                      "description": "Otras actividades con el docente (asincrónicas), o null."
                    }
                  },
                  "description": "Actividad con el docente. asincronica: otras actividades con el docente, o null."
                },
                "practico": {
                  "$ref": "#/$defs/actividad"
                },
                "autonomo": {
                  "$ref": "#/$defs/actividad"
                },
                "entregables": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Opcional. Si no viene, el sistema los detecta en las actividades (Tarea n, PAE n, Evaluación cognitiva n). El sistema nunca resuelve un entregable."
                }
              }
            }
          }
        }
      }
    },
    "rubrica_producto_final": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fila_rubrica"
      },
      "description": "Opcional. Rúbrica del producto final."
    },
    "pis": {
      "type": "object",
      "description": "Opcional. Proyecto integrador de saberes; entra al contexto de generación. Los textos pueden ir vacíos.",
      "additionalProperties": false,
      "required": [
        "nombre",
        "aporte"
      ],
      "properties": {
        "nombre": {
          "type": "string"
        },
        "aporte": {
          "type": "string"
        }
      }
    },
    "metodologias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Opcional. Hoy no entra al contexto."
    },
    "bibliografia": {
      "type": "object",
      "description": "Opcional. Hoy no entra al contexto.",
      "additionalProperties": false,
      "properties": {
        "basica": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "complementaria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "actividad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texto"
      ],
      "properties": {
        "texto": {
          "type": "string"
        },
        "horas": {
          "type": "number"
        }
      },
      "description": "texto es obligatorio y puede ir vacío; horas es opcional."
    },
    "fila_rubrica": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicador",
        "niveles"
      ],
      "properties": {
        "indicador": {
          "type": "string"
        },
        "niveles": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Descriptor por nivel. Claves esperadas: receptivo, resolutivo, reflexivo, critico, cocreativo."
        }
      }
    }
  }
}
