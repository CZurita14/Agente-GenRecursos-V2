# Copiar a .env y completar. .env no se versiona.
POSTGRES_DB=genrecursos
POSTGRES_USER=genrecursos
POSTGRES_PASSWORD=cambiar
DB_PORT=15432
# Carpeta con la documentación oficial de las carreras (fuera del repositorio)
DOCS_CARRERAS=C:/ruta/a/Documentacion carreras
# Datos estructurados de otros proyectos (kb/importar_estructurados.py)
SILABOS_SALIDA=C:/ruta/a/SILABOS/salida
PERFILES_EGRESO=C:/ruta/a/AGENTE-EMPLEO/docs/perfiles-egreso

# --- Backend (P1 · núcleo multiagente) ---
DATABASE_URL=postgresql://genrecursos:cambiar@127.0.0.1:15432/genrecursos
LLM_BASE_URL=http://172.16.8.69:8000/v1
LLM_MODEL=Qwen/Qwen3-8B-AWQ
LLM_API_KEY=no-se-necesita
# Proveedor del modelo: vllm (servidor local, valores de arriba) o deepseek. Con DeepSeek:
#   LLM_PROVEEDOR=deepseek  LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-v4-pro
#   LLM_API_KEY=<clave de DeepSeek; nunca en git>
# El contenido académico del sílabo (sin datos personales) se envía a DeepSeek.
LLM_PROVEEDOR=vllm
# false solo en desarrollo, si un antivirus inspecciona HTTPS (raíz que Python 3.13 rechaza).
LLM_TLS_ESTRICTO=true
# Imágenes de la presentación (PowerPoint), en este orden: Unsplash (Access Key de
# https://unsplash.com/developers; en modo demo, 50 búsquedas por hora), Pexels (https://www.pexels.com/api/),
# Wikimedia Commons y Openverse (sin clave; solo CC BY, CC BY-SA, CC0 y dominio público).
# Unsplash exige mostrar su foto desde images.unsplash.com (ya permitido en la CSP de nginx).
# Solo se envían las palabras de búsqueda. La clave nunca va a git.
IMAGENES_ACTIVAS=true
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
LLM_MAX_CONCURRENCIA=4
LLM_TIMEOUT_S=120
LLM_TIMEOUT_REVISOR_S=240
LEASE_S=360
AGENTES_DIR=agentes

# --- P4: origen exacto del frontend (sin barra final) ---
API_ORIGEN=http://localhost:5173
ENTORNO=desarrollo
# Generar un secreto aleatorio propio de al menos 32 caracteres, no versionarlo.
# Sin AUTH_SECRETO la API devuelve 503 al solicitar ingreso.
# AUTH_SECRETO=
# ACCESO_PRUEBA=true: entrar sin autenticar contra el SGA (solo desarrollo).
# La aplicación no arranca con esto en producción; úsalo solo con datos de prueba.
# En producción usar API_ORIGEN=https://... y ENTORNO=produccion.

# --- V2: SGA ---
# "simulado" (solo desarrollo) lee fixtures; "real" espera el adaptador de TI (B-SGA1).
# SGA_SIMULADO_DIR es relativa a la raíz del proyecto y debe contener usuarios.json.
SGA_PROVEEDOR=simulado
SGA_SIMULADO_DIR=backend/tests/fixtures/sga
# Tiempo máximo por llamada al SGA (s).
SGA_TIMEOUT_S=15
# Presupuesto de la sincronización al ingresar (s); debe ser menor que los 65 s del proxy.
SGA_SINCRONIZACION_MAX_S=45

# JSON se limita antes de decodificarlo.
API_JSON_MAX_BYTES=1048576
API_JSON_TIMEOUT_S=30

# --- P4 A5: listas JSON; por defecto nadie administra ni se confía en proxies ---
ADMINISTRADORES=[]
PROXIES_CONFIABLES=[]
LIMITE_IP_MINUTO=600
LIMITE_USUARIO_MINUTO=120
LIMITE_INGRESAR_IP_MINUTO=60
LIMITE_INGRESAR_USUARIO_MINUTO=20
LIMITE_GENERAR_CORREO_HORA=30
LIMITE_EDITAR_CORREO_MINUTO=30
AUDITORIA_RETENCION_DIAS=30
