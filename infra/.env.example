# Copiar fuera del repositorio; validar con infra/operar.py antes de arrancar.
# No usar el .env de desarrollo ni su volumen. Certificados provistos por TI.
COMPOSE_PROJECT_NAME=genrecursos-app
POSTGRES_DB=materiales
POSTGRES_USER=materiales
POSTGRES_PASSWORD=
AUTH_SECRETO=
ENTORNO=produccion
DOMINIO=materiales.example.invalid
API_ORIGEN=https://materiales.example.invalid
IP_PUBLICACION=127.0.0.1
PUERTO_HTTP=80
PUERTO_HTTPS=443
TLS_DIR=/ruta/absoluta/certificados
RED_PROXY=172.31.250.0/28
IP_PROXY=172.31.250.2
RANGO_DINAMICO=172.31.250.8/29
LLM_BASE_URL=http://servidor-interno:8000/v1
LLM_MODEL=Qwen/Qwen3-8B-AWQ
LLM_API_KEY=no-se-necesita
LLM_MAX_CONCURRENCIA=1
ADMINISTRADORES=[]
# Cuotas (peticiones por minuto u hora) y retención en días. Con NAT institucional, subir LIMITE_IP_MINUTO.
LIMITE_IP_MINUTO=600
LIMITE_USUARIO_MINUTO=120
LIMITE_INGRESAR_IP_MINUTO=60
LIMITE_INGRESAR_USUARIO_MINUTO=20
LIMITE_GENERAR_CORREO_HORA=30
LIMITE_PDF_CORREO_HORA=10
LIMITE_EDITAR_CORREO_MINUTO=30
AUDITORIA_RETENCION_DIAS=30
# Razonador entrenado (opcional, solo worker). Vacío = apagado. Para activarlo: ruta dentro del contenedor, p. ej. /modelos/v1.
# Exige un modelo aprobado (docs/ciencia-datos.md); con uno de prueba el worker no arranca.
RAZONADOR_RUTA=
# SGA: "simulado" (fixtures de pruebas, solo desarrollo) o "real" (adaptador pendiente de TI, B-SGA1).
# SGA_SIMULADO_DIR: carpeta con usuarios.json, materias/ y sga_silabos/ (backend/tests/fixtures/sga). Sin secretos.
SGA_PROVEEDOR=simulado
SGA_SIMULADO_DIR=
SGA_TIMEOUT_S=15
